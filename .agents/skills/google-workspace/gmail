#!/bin/bash
# Gmail API Reader - Read Gmail messages via API

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

command="$1"
shift || true

case "$command" in
    ""|"help"|"-h"|"--help")
        echo "Gmail API Reader - Read Gmail messages"
        echo ""
        echo "Usage: gmail <command> [args...]"
        echo ""
        echo "Commands:"
        echo "  list [max] [query] [labels]  - List messages"
        echo "  get <message_id>             - Get full message"
        echo "  body <message_id>             - Get message body only"
        echo "  open                         - Open Gmail in browser"
        echo ""
        echo "Examples:"
        echo "  # List 10 most recent messages"
        echo "  gmail list"
        echo ""
        echo "  # List 20 messages"
        echo "  gmail list 20"
        echo ""
        echo "  # List messages from specific sender"
        echo "  gmail list 50 'from:example.com'"
        echo ""
        echo "  # List unread messages"
        echo "  gmail list 50 'is:unread'"
        echo ""
        echo "  # List messages with label"
        echo "  gmail list 50 '' 'INBOX'"
        echo ""
        echo "  # List starred messages"
        echo "  gmail list 50 '' 'STARRED'"
        echo ""
        echo "  # Get specific message (use ID from list output)"
        echo "  gmail get 123456789abcdef"
        echo ""
        echo "  # Get message body only"
        echo "  gmail body 123456789abcdef"
        echo ""
        echo "Notes:"
        echo "  - Gmail API must be enabled in Google Cloud Console"
        echo "  - Message IDs are shown in the list output"
        echo "  - Use Gmail search syntax for query (is:unread, from:, has:attachment, etc.)"
        ;;

    list)
        MAX_RESULTS="$1"
        QUERY="$2"
        LABELS="$3"

        cd "$SCRIPT_DIR" && uv run google_gmail_api.py list "${MAX_RESULTS:-10}" ${QUERY:+\"$QUERY\"} ${LABELS:+\"$LABELS\"}
        ;;

    get)
        if [ -z "$1" ]; then
            echo "❌ Error: get command requires message_id"
            echo "  Usage: gmail get <message_id>"
            exit 1
        fi
        cd "$SCRIPT_DIR" && uv run google_gmail_api.py get "$@"
        ;;

    body)
        if [ -z "$1" ]; then
            echo "❌ Error: body command requires message_id"
            echo "  Usage: gmail body <message_id>"
            exit 1
        fi
        cd "$SCRIPT_DIR" && uv run google_gmail_api.py body "$@"
        ;;

    open)
        echo "🌐 Opening Gmail in browser..."
        open "https://mail.google.com"
        ;;

    *)
        echo "❌ Unknown command: $command"
        echo "Run 'gmail help' for usage information"
        exit 1
        ;;
esac
