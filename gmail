#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command="${1:-help}"
shift || true

if [[ "$command" == "open" ]]; then
    open "https://mail.google.com"
    exit 0
fi

if [[ "$command" == "help" || "$command" == "-h" || "$command" == "--help" ]]; then
    echo "Gmail API Reader"
    echo "Usage: $0 <list|get|body|open> [args...]"
    exit 0
fi

cd "$SCRIPT_DIR"
uv run gworkspace gmail "$command" "$@"
