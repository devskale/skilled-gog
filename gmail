#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command="${1:-help}"
shift || true

if [[ "$command" == "open" ]]; then
    open "https://mail.google.com"
    exit 0
fi

if [[ "$command" == "help" || "$command" == "-h" || "$command" == "--help" ]]; then
    echo "Gmail API Tool"
    echo "Usage: $0 <list|get|body|send|open> [args...]"
    echo ""
    echo "Commands:"
    echo "  list [max] [query]     - List messages"
    echo "  get <message_id>       - Get full message"
    echo "  body <message_id>      - Get message body only"
    echo "  send <to> <subj> <msg> - Send email"
    echo "  open                   - Open Gmail in browser"
    exit 0
fi

cd "$SCRIPT_DIR"
uv run gworkspace gmail "$command" "$@"
